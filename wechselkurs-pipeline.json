      "name": "Kurse abrufen (Frankfurter-API)"
    },
    {
      "parameters": {
        "jsCode": "// Die Frankfurter-API liefert zwei Formen:\n//  - Zeitraum (z. B. 2026-06-01..2026-09-19): rates = { \"2026-06-02\": { USD: ..., ... }, ... }\n//  - Tageskurs (latest):                      date = \"2026-09-25\", rates = { USD: ..., ... }\n// Beide werden in dieselbe flache Tabellenform gebracht: eine Zeile pro Tag.\nconst data = $input.first().json;\nconst rates = data.rates || {};\n\nconst istTageskurs = typeof Object.values(rates)[0] === 'number';\nconst eintraege = istTageskurs ? [[data.date, rates]] : Object.entries(rates);\n\nconst rows = eintraege.map(([datum, werte]) => ({\n  datum,\n  USD: werte.USD ?? null,\n  GBP: werte.GBP ?? null,\n  PLN: werte.PLN ?? null,\n  CHF: werte.CHF ?? null,\n}));\n\nrows.sort((a, b) => a.datum.localeCompare(b.datum));\n\nreturn rows.map(r => ({ json: r }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
